{
  "name": "crm-project-devcontainer",
  "build": {
    "dockerfile": "Dockerfile.devcontainer",
    "context": ".."
  },
  "containerEnv": {
    "POETRY_VIRTUALENVS_IN_PROJECT": "1",
    "POETRY_VIRTUALENVS_CREATE": "1"
  },
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/backend/.venv",
    "PATH": "${containerWorkspaceFolder}/backend/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash -lc \"git config --global --add safe.directory ${containerWorkspaceFolder} && cd backend && poetry config virtualenvs.in-project true --local && bash -lc './scripts/install_aws_tools.sh' && poetry install --no-root\"",
  "postStartCommand": "bash -lc \"git config --global --add safe.directory ${containerWorkspaceFolder} && cd backend && poetry config virtualenvs.in-project true --local && (test -f .venv/pyvenv.cfg && .venv/bin/python -c 'import fastapi' >/dev/null 2>&1 || poetry install --no-root)\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
        "workbench.colorTheme": "Default Dark+"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [
    8000,
    8081,
    8082
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "8081": {
      "label": "Expo Web (customer)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "8082": {
      "label": "Expo Web (instructor)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  }
}