# 사용법:
# 1) 이 파일을 .env 로 복사
#    cp .env.example .env
# 2) 빈 값들을 채우기 (절대 .env를 git에 올리지 말 것)

# ====== Database (Supabase Postgres / Pooler session 권장) ======
# 예시:
# DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ====== SQLAlchemy echo (SQL 로그 출력) ======
# 운영 기본 : false
DB_ECHO=false

# ====== DB_SSL_VERIFY ======
# pooler(6543)에서 SSL 검증 이슈가 있을 때만 false로
# direct DB(5432) 쓰면 true 유지 추천
DB_SSL_VERIFY=true

# ====== Supabase Auth / API ======
# 예시:
# SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_URL=

# ====== Supabase anon/public key ======
SUPABASE_ANON_KEY=

# ====== Supabase JWT secret ======
# (Dashboard -> Project Settings -> API -> JWT Secrets)
SUPABASE_JWT_SECRET=

# 보통 그대로 사용
SUPABASE_JWT_AUDIENCE=authenticated

# ====== CORS ======

# 개발: 전체 허용 (프론트 도메인 확정되면 제한 권장)
CORS_ALLOW_ORIGINS=["*"]

# ====== Optional / Future ======
# 예: 운영에서만 특정 값 쓰고 싶으면 여기에 추가해도 됨
# ENV=local