name: Deploy
run-name: >
  Deploy | ${{ github.event_name }} |
  ${{ startsWith(github.ref, 'refs/tags/v') && format('prod {0}', github.ref_name) || format('staging {0}', github.event.workflow_run.head_sha) }}

on:
  workflow_run:
    workflows: ["CI"]     # CI workflow 이름과 동일
    types: [completed]
    branches: [main]

  push:
    tags:
      - "v*"

permissions:
  id-token: write
  contents: read

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy-staging:
    name: Deploy (staging)
    if: >
      github.event_name == 'workflow_run' &&
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.event == 'push' &&
      github.event.workflow_run.head_branch == 'main'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_TO_ASSUME }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Install AWS Copilot
        run: |
          curl -Lo copilot-cli https://github.com/aws/copilot-cli/releases/latest/download/copilot-linux
          chmod +x copilot-cli
          mkdir -p ~/.local/bin
          mv copilot-cli ~/.local/bin/copilot
          echo "$HOME/.local/bin" >> $GITHUB_PATH
          copilot --version

      - name: Deploy (staging)
        run: copilot svc deploy --name api --env staging

      - name: Install jq (for parsing copilot json)
        run: |
          sudo apt-get update
          sudo apt-get install -y jq

      - name: Resolve staging URL
        id: staging_url
        run: |
          set -euo pipefail

          ENV_NAME="staging"

          # svc show는 --env가 없음. routes에서 environment=staging인 것만 골라서 url 뽑아야 함.
          STAGING_URL=$(
            copilot svc show --name api --json \
            | jq -r --arg env "$ENV_NAME" '.routes[] | select(.environment==$env) | .url' \
            | head -n 1
          )

          if [ -z "$STAGING_URL" ] || [ "$STAGING_URL" = "null" ]; then
            echo "ERROR: Failed to resolve staging URL from copilot svc show"
            echo "DEBUG: copilot svc show output:"
            copilot svc show --name api --json | jq .
            exit 1
          fi

          echo "STAGING_URL=$STAGING_URL" >> "$GITHUB_OUTPUT"
          echo "Staging URL: $STAGING_URL"

      - name: Wait for service to be ready (retry /health/ready)
        run: |
          set -euo pipefail
          URL="${{ steps.staging_url.outputs.STAGING_URL }}"
          echo "Waiting for $URL/health/ready ..."

          # Max ~180s (36 * 5s)
          for i in {1..36}; do
            if curl -fsS "$URL/health/ready" > /dev/null; then
              echo "OK: /health/ready is ready"
              exit 0
            fi
            echo "Not ready yet... ($i/36)"
            sleep 5
          done

          echo "ERROR: service did not become ready in time"
          exit 1

      - name: Smoke test (staging) - /health/ready must be 200
        run: |
          set -euo pipefail
          URL="${{ steps.staging_url.outputs.STAGING_URL }}"
          echo "GET $URL/health/ready"
          curl -fS "$URL/health/ready" > /dev/null

      - name: Rehearsal check (staging) - /docs reachable (FastAPI)
        run: |
          set -euo pipefail
          URL="${{ steps.staging_url.outputs.STAGING_URL }}"
          echo "GET $URL/docs"
          curl -fS "$URL/docs" > /dev/null

      - name: Rehearsal check (staging) - openapi
        run: |
          set -euo pipefail
          URL="${{ steps.staging_url.outputs.STAGING_URL }}"
          echo "GET $URL/openapi.json"
          curl -fS "$URL/openapi.json" > /dev/null


  deploy-prod:
    name: Deploy (prod)
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    # environment: prod   # (선택) environment secrets/vars 쓸 때만 켜. 켜면 prod env에서 tags(v*) 허용 필요.

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Ensure tag commit is contained in main
        shell: bash
        run: |
          set -euo pipefail

          # Make sure we have enough history for ancestry checks.
          git fetch --no-tags origin main

          TAG_SHA="$(git rev-list -n 1 "${GITHUB_REF}")"
          echo "Tag points to: $TAG_SHA"

          if git merge-base --is-ancestor "$TAG_SHA" "origin/main"; then
            echo "OK: tag commit is contained in origin/main"
          else
            echo "ERROR: tag commit is NOT contained in origin/main"
            exit 1
          fi

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_TO_ASSUME }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Install AWS Copilot
        run: |
          curl -Lo copilot-cli https://github.com/aws/copilot-cli/releases/latest/download/copilot-linux
          chmod +x copilot-cli
          mkdir -p ~/.local/bin
          mv copilot-cli ~/.local/bin/copilot
          echo "$HOME/.local/bin" >> $GITHUB_PATH
          copilot --version

      - name: Deploy (prod)
        run: copilot svc deploy --name api --env prod

      - name: Install jq (for parsing copilot json)
        run: |
          sudo apt-get update
          sudo apt-get install -y jq

      - name: Resolve prod URL
        id: prod_url
        run: |
          set -euo pipefail
          ENV_NAME="prod"
          PROD_URL=$(
            copilot svc show --name api --json \
            | jq -r --arg env "$ENV_NAME" '.routes[] | select(.environment==$env) | .url' \
            | head -n 1
          )
          if [ -z "$PROD_URL" ] || [ "$PROD_URL" = "null" ]; then
            echo "ERROR: Failed to resolve prod URL"
            exit 1
          fi
          echo "PROD_URL=$PROD_URL" >> "$GITHUB_OUTPUT"
          echo "Prod URL: $PROD_URL"

      - name: Smoke test (prod) - /health/ready must be 200
        run: |
          set -euo pipefail
          URL="${{ steps.prod_url.outputs.PROD_URL }}"
          echo "GET $URL/health/ready"
          curl -fS "$URL/health/ready" > /dev/null

      - name: Rehearsal check (prod) - openapi
        run: |
          set -euo pipefail
          URL="${{ steps.prod_url.outputs.PROD_URL }}"
          echo "GET $URL/openapi.json"
          curl -fS "$URL/openapi.json" > /dev/null

      - name: Resolve prod ALB/TG suffix (for CloudWatch alarms)
        id: prod_alarm_dims
        shell: bash
        run: |
          set -euo pipefail

          # 1) prod 스택 찾기 (AddonsStack 제외)
          STACK_NAME="$(aws cloudformation list-stacks \
            --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE UPDATE_ROLLBACK_COMPLETE \
            --query "StackSummaries[?contains(StackName, \`crm-prod-api\`) == \`true\`].StackName" \
            --output text | tr '\t' '\n' | grep -v AddonsStack | head -n 1)"

          if [ -z "$STACK_NAME" ]; then
            echo "ERROR: prod stack not found (expected contains: crm-prod-api)"
            exit 1
          fi
          echo "Stack: $STACK_NAME"

          # 2) TG ARN 추출 (TargetGroup 리소스 중 첫 번째 사용)
          TG_ARN="$(aws cloudformation describe-stack-resources \
            --stack-name "$STACK_NAME" \
            --query "StackResources[?ResourceType==\`AWS::ElasticLoadBalancingV2::TargetGroup\`].PhysicalResourceId | [0]" \
            --output text)"

          if [ -z "$TG_ARN" ] || [ "$TG_ARN" = "None" ]; then
            echo "ERROR: target group ARN not found in stack resources"
            exit 1
          fi
          echo "TG_ARN: $TG_ARN"

          # 3) TG -> LB ARN 역추적
          LB_ARN="$(aws elbv2 describe-target-groups \
            --target-group-arns "$TG_ARN" \
            --query "TargetGroups[0].LoadBalancerArns[0]" \
            --output text)"

          if [ -z "$LB_ARN" ] || [ "$LB_ARN" = "None" ]; then
            echo "ERROR: load balancer ARN not found from target group"
            exit 1
          fi
          echo "LB_ARN: $LB_ARN"

          # 4) CloudWatch Dimension suffix 생성
          # - LoadBalancer: app/<lb-name>/<lb-id>
          # - TargetGroup : <tg-name>/<tg-id>
          PROD_LB_SUFFIX="$(echo "$LB_ARN" | sed 's#^.*loadbalancer/##')"
          PROD_TG_SUFFIX="$(echo "$TG_ARN" | sed 's#^.*targetgroup/##')"

          if [ -z "$PROD_LB_SUFFIX" ] || [ -z "$PROD_TG_SUFFIX" ]; then
            echo "ERROR: failed to parse suffix"
            exit 1
          fi

          echo "PROD_LB_SUFFIX=$PROD_LB_SUFFIX" >> "$GITHUB_OUTPUT"
          echo "PROD_TG_SUFFIX=$PROD_TG_SUFFIX" >> "$GITHUB_OUTPUT"
          echo "Resolved: PROD_LB_SUFFIX=$PROD_LB_SUFFIX"
          echo "Resolved: PROD_TG_SUFFIX=$PROD_TG_SUFFIX"

      - name: Resolve SNS Topic ARN (crm-prod-alarms)
        id: prod_alarm_topic
        shell: bash
        run: |
          set -euo pipefail

          TOPIC_NAME="crm-prod-alarms"
          TOPIC_ARN="$(aws sns list-topics --query "Topics[].TopicArn" --output text | tr '\t' '\n' | grep ":${TOPIC_NAME}$" | head -n 1)"

          if [ -z "$TOPIC_ARN" ]; then
            echo "ERROR: SNS topic not found: $TOPIC_NAME"
            echo "Hint: create topic first or ensure name matches"
            exit 1
          fi

          echo "TOPIC_ARN=$TOPIC_ARN" >> "$GITHUB_OUTPUT"
          echo "SNS Topic ARN: $TOPIC_ARN"

      - name: Apply baseline CloudWatch alarms (prod) - idempotent
        shell: bash
        run: |
          set -euo pipefail

          LB_SUFFIX="${{ steps.prod_alarm_dims.outputs.PROD_LB_SUFFIX }}"
          TG_SUFFIX="${{ steps.prod_alarm_dims.outputs.PROD_TG_SUFFIX }}"
          TOPIC_ARN="${{ steps.prod_alarm_topic.outputs.TOPIC_ARN }}"

          echo "Using dimensions:"
          echo "  LoadBalancer=$LB_SUFFIX"
          echo "  TargetGroup=$TG_SUFFIX"
          echo "Alarm actions -> $TOPIC_ARN"

          # (1) Target 5XX 급증 알람
          aws cloudwatch put-metric-alarm \
            --alarm-name "crm-prod-api-Target5XX" \
            --alarm-description "prod api target 5xx count high (ALB->TargetGroup)" \
            --namespace "AWS/ApplicationELB" \
            --metric-name "HTTPCode_Target_5XX_Count" \
            --dimensions Name=LoadBalancer,Value="$LB_SUFFIX" Name=TargetGroup,Value="$TG_SUFFIX" \
            --statistic Sum \
            --period 60 \
            --evaluation-periods 5 \
            --datapoints-to-alarm 3 \
            --threshold 10 \
            --comparison-operator GreaterThanOrEqualToThreshold \
            --treat-missing-data notBreaching \
            --alarm-actions "$TOPIC_ARN" \
            --ok-actions "$TOPIC_ARN"

          # (2) UnhealthyHostCount 알람
          aws cloudwatch put-metric-alarm \
            --alarm-name "crm-prod-api-UnhealthyHostCount" \
            --alarm-description "prod api unhealthy targets detected (TargetGroup health)" \
            --namespace "AWS/ApplicationELB" \
            --metric-name "UnHealthyHostCount" \
            --dimensions Name=LoadBalancer,Value="$LB_SUFFIX" Name=TargetGroup,Value="$TG_SUFFIX" \
            --statistic Maximum \
            --period 60 \
            --evaluation-periods 3 \
            --datapoints-to-alarm 2 \
            --threshold 1 \
            --comparison-operator GreaterThanOrEqualToThreshold \
            --treat-missing-data notBreaching \
            --alarm-actions "$TOPIC_ARN" \
            --ok-actions "$TOPIC_ARN"

          echo "OK: baseline alarms applied/updated"
        
