{
  "expo": {
    "name": "instructor",
    "slug": "instructor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "instructor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": { "edgeToEdgeEnabled": true },
    "web": { "output": "static" },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
